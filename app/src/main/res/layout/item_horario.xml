<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABEÇALHO: HORA E NÚMERO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvHoraComboio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Partida: 00:00"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNumeroComboio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Nº 12345"
                android:textColor="#666666"
                android:textSize="13sp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#EEEEEE" />

        <!-- ROTA: Ocupa a largura toda e pode crescer para baixo -->
        <TextView
            android:id="@+id/tvRotaComboio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Origem ➔ Destino"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:minLines="1" />

        <!-- TIPO DE SERVIÇO: Colocado em baixo para dar ar de "Bilhete" -->
        <TextView
            android:id="@+id/tvTipoServico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F0F0F0"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="REGIONAL"
            android:textColor="#444444"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>